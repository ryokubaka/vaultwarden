# Copy to backup.env and adjust. Used by the `backup` service
# (offen/docker-volume-backup — https://github.com/offen/docker-volume-backup).
#
# Default: archives land in whatever you mount at /archive (see docker-compose.yml
# NAS_BACKUP_PATH, default ./backups on the host).

########### Schedule / archive
# Daily 02:15 local time (container TZ). See https://crontab.guru
BACKUP_CRON_EXPRESSION=15 2 * * *
BACKUP_FILENAME=vw-portable-%Y-%m-%dT%H-%M-%S.{{ .Extension }}
BACKUP_COMPRESSION=gz
BACKUP_LATEST_SYMLINK=vw-portable.latest.tar.gz
BACKUP_ARCHIVE=/archive

# Keep remote/local archives this many days (-1 = never prune)
BACKUP_RETENTION_DAYS=30

# Optional: set timezone for cron (IANA name)
# TZ=America/New_York

########### NAS via host mount (recommended)
# 1) Mount the NAS share on the Docker host (NFS or CIFS), e.g.:
#      /mnt/nas/vaultwarden-backups
# 2) In .env set:
#      NAS_BACKUP_PATH=/mnt/nas/vaultwarden-backups
# Compose binds that path to /archive. No SSH_* needed.

########### NAS via SSH/SFTP (optional alternative or second copy)
# Leave SSH_HOST_NAME empty to skip SSH backend.
# SSH_HOST_NAME=nas.plant.local
# SSH_PORT=22
# SSH_USER=vwbackup
# SSH_REMOTE_PATH=/volume1/backups/vaultwarden
# Prefer key auth — mount a key and point at it:
# SSH_IDENTITY_FILE=/root/.ssh/id_ed25519
# SSH_PASSWORD=
# SSH_IDENTITY_PASSPHRASE=

########### Optional GPG encryption at rest on the NAS
# BACKUP_GPG_PASSPHRASE=
# (or use BACKUP_GPG_PUBLIC_KEY / key file — see offen docs)

########### Optional notify on failure (SMTP — separate from Vaultwarden)
# NOTIFICATION_URLS=
