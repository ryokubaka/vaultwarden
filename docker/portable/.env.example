# Copy to .env and edit before first start:
#   cp .env.example .env

# Public HTTPS URLs (must match DNS / hosts and Caddy hostnames)
DOMAIN=https://vw.org-testing.meow
VW_HOST=vw.org-testing.meow
MAIL_HOST=mail.org-testing.meow

# Bootstrap: create first account, then set SIGNUPS_ALLOWED=false and recreate vaultwarden
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false

# Org Groups in Admin Console (assign groups → collections). Default on for this pack.
# Upstream marks this beta; disable if you hit client bugs: ORG_GROUPS_ENABLED=false
ORG_GROUPS_ENABLED=true

# Required — Argon2 PHC hash (not plaintext). Generate:
#   docker run --rm -it vaultwarden/server /vaultwarden hash
# Type a long secret twice. Paste the $argon2id$... line below in SINGLE quotes.
# Login to /admin with the secret you typed — not the PHC string.
# Do not commit .env
ADMIN_TOKEN='$argon2id$v=19$m=65540,t=3,p=4$REPLACE_ME'

# =============================================================================
# SMTP — pick ONE block (uncomment/fill). Invite links still use DOMAIN above.
# =============================================================================

# --- A) Gmail (test now — real inbox) ---
# Create an App Password: https://myaccount.google.com/apppasswords
# (2FA must be on for the Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=you@gmail.com
SMTP_FROM_NAME=Vaultwarden

# --- B) Mailjet / Brevo / other transactional (test now — real inbox) ---
# SMTP_HOST=in-v3.mailjet.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=<api-key>
# SMTP_PASSWORD=<api-secret>
# SMTP_FROM=verified-sender@yourdomain.com
# SMTP_FROM_NAME=Vaultwarden

# --- C) Mailpit (catch-all UI only; no real inbox) ---
# Start with: docker compose --profile mailpit up -d
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_SECURITY=off
# SMTP_FROM=vaultwarden@org-testing.meow
# SMTP_FROM_NAME=Vaultwarden
# (omit SMTP_USERNAME / SMTP_PASSWORD)

# --- D) Office 365 Option 1 (recommended) — IP connector / SMTP relay ---
# SMTP_HOST=contoso-com.mail.protection.outlook.com
# SMTP_PORT=25
# SMTP_SECURITY=starttls
# SMTP_FROM=vaultwarden@contoso.com
# SMTP_FROM_NAME=Vaultwarden
# (omit SMTP_USERNAME / SMTP_PASSWORD)

# --- E) Office 365 Option 2 — email-oauth2-proxy ---
# See docs/email-oauth2-proxy.md
# cp emailproxy/emailproxy.config.example emailproxy/emailproxy.config
# docker compose --profile oauth-smtp up -d
# SMTP_HOST=emailproxy
# SMTP_PORT=1587
# SMTP_SECURITY=off
# SMTP_USERNAME=vaultwarden@contoso.com
# SMTP_PASSWORD=proxy-local-secret
# SMTP_FROM=vaultwarden@contoso.com
# SMTP_FROM_NAME=Vaultwarden

# --- F) Office 365 Option 3 — SMTP AUTH (easiest, weakest) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=vaultwarden@contoso.com
# SMTP_PASSWORD=
# SMTP_FROM=vaultwarden@contoso.com
# SMTP_FROM_NAME=Vaultwarden
